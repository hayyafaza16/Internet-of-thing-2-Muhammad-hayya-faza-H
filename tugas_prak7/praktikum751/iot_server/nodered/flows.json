    {
        "id": "e257891d5fd9ceb7",
        "type": "function",
        "z": "9e42be329637dbbf",
        "name": "function 1",
        "func": "// Mengambil status LED sebelumnya dari context memori Node-RED (default: 0 / mati)\nlet state = context.get('ledState') || 0;\nlet temp = msg.payload.temp; // Mengambil data suhu dari payload masukan\n\n// Logika Histeresis\nif (temp > 31.5) {\n    state = 1; // Menyala jika suhu melebihi 31.5 C\n} else if (temp < 30.0) {\n    state = 0; // Padam jika suhu mendingin di bawah 30.0 C\n}\n// Jika suhu berada di antara 30.0 C dan 31.5 C, nilai 'state' tidak berubah (menahan status terakhir)\n\n// Menyimpan status LED terbaru ke memori context\ncontext.set('ledState', state);\n\n// Mengirimkan payload baru\nmsg.payload = { \"led\": state };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 240,
        "wires": [
